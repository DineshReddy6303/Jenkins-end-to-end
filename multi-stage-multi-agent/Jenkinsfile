
pipeline {
    agent none

    stages {

        stage('Checkout') {
            agent {
                docker {
                    image 'alpine:latest'
                }
            }
            steps {
                checkout scm

                sh '''
                    echo "===== Workspace ====="
                    pwd
                    echo "===== Files ====="
                    ls -la
                    echo "===== POM files ====="
                    find . -name pom.xml -print
                '''
            }
        }

        stage('Build') {
            agent {
                docker {
                    image 'maven:3.8.8-eclipse-temurin-17'
                }
            }
            steps {
                sh '''
                    echo "===== Java Version ====="
                    java -version

                    echo "===== Maven Version ====="
                    mvn -version

                    echo "===== Building Application ====="
                    mvn clean package
                '''
            }
        }

        stage('Test') {
            agent {
                docker {
                    image 'maven:3.8.8-eclipse-temurin-17'
                }
            }
            steps {
                sh '''
                    echo "===== Running Tests ====="
                    mvn test
                '''
            }
        }

        stage('Docker') {
            agent {
                docker {
                    image 'docker:24'
                }
            }
            steps {
                sh '''
                    echo "===== Docker Version ====="
                    docker --version
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the stage logs above.'
        }

        always {
            echo 'Pipeline finished.'
        }
    }
}


