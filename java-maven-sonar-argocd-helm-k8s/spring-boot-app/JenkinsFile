pipeline {
    agent {
        docker {
            image 'dineshreddy6303/maven-docker-agent:v1'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    environment {
        SONAR_URL = 'http://3.111.170.241:9000'
        DOCKER_IMAGE = "jibbbox/ultimate-cicd:${BUILD_NUMBER}"
        GIT_REPO_NAME = 'Jenkins-end-to-end'
        GIT_USER_NAME = 'DineshReddy6303'
        APP_DIR = 'java-maven-sonar-argocd-helm-k8s/spring-boot-app'
        DEPLOYMENT_FILE = 'java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml'
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code'
                checkout scm
                sh 'ls -ltr'
            }
        }

        stage('Build and Test') {
            steps {
                dir("${APP_DIR}") {
                    sh 'mvn clean package'
                }
            }
        }

        stage('Static Code Analysis') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'sonarqube',
                        variable: 'SONAR_AUTH_TOKEN'
                    )
                ]) {
                    dir("${APP_DIR}") {
                        sh '''
                            mvn sonar:sonar \
                              -Dsonar.host.url="$SONAR_URL" \
                              -Dsonar.token="$SONAR_AUTH_TOKEN"
                        '''
                    }
                }
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                script {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'docker-token',
                            usernameVariable: 'DOCKER_USERNAME',
                            passwordVariable: 'DOCKER_PASSWORD'
                        )
                    ]) {
                        sh '''
                            echo "$DOCKER_PASSWORD" | docker login \
                              -u "$DOCKER_USERNAME" \
                              --password-stdin
                        '''

                        dir("${APP_DIR}") {
                            sh '''
                                docker build -t "$DOCKER_IMAGE" .
                                docker push "$DOCKER_IMAGE"
                            '''
                        }

                        sh 'docker logout'
                    }
                }
            }
        }

        stage('Update Deployment File') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        git config user.email "dineshreddybuchupalli41@gmail.com"
                        git config user.name "DineshReddy6303"

                        sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" "$DEPLOYMENT_FILE"

                        git add "$DEPLOYMENT_FILE"

                        if ! git diff --cached --quiet; then
                            git commit -m "Update deployment image to version ${BUILD_NUMBER}"

                            git -c http.extraheader="AUTHORIZATION: basic $(printf 'x-access-token:%s' "$GITHUB_TOKEN" | base64 | tr -d '\\n')" \
                                push origin HEAD:main
                        else
                            echo "No deployment changes to commit"
                        fi
                    '''
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline execution completed'
        }

        success {
            echo 'CI/CD pipeline completed successfully'
        }

        failure {
            echo 'Pipeline failed. Check the console output for details.'
        }
    }
}
```
